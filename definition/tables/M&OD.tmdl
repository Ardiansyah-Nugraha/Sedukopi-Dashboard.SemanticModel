table M&OD
	lineageTag: 61fb8f91-ed02-49be-b31f-afb7442cc209

	measure GMV = SUM('M&OD'[subtotal])
		formatString: "Rp"#,0;-"Rp"#,0;"Rp"#,0
		lineageTag: 1ec6fb65-1363-4423-986d-d25dfd331e2b

		annotation PBI_FormatHint = {"currencyCulture":"id-ID"}

	measure CostHPP = SUMX('M&OD', 'M&OD'[cost_price]*'M&OD'[quantity])
		formatString: 0
		lineageTag: d8699cee-0922-4b23-8165-c4065f665b86

	measure 'Profit Gross' = [GMV]-[CostHPP]
		formatString: "Rp"#,0;-"Rp"#,0;"Rp"#,0
		lineageTag: 449a3971-6075-4007-9b85-3b2a60a634ca

		annotation PBI_FormatHint = {"currencyCulture":"id-ID"}

	measure 'Profit Margin%' = ```
			DIVIDE([Profit Gross], [GMV],0) 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 05350a18-8e52-49b1-8600-a7e4cff763fd

	measure AOV = DIVIDE(SUM('M&OD'[subtotal]), DISTINCTCOUNT('M&OD'[order_id]))
		formatString: "Rp"#,0;-"Rp"#,0;"Rp"#,0
		lineageTag: 61b98bc7-2126-459b-ab1e-dde4527a806a

		annotation PBI_FormatHint = {"currencyCulture":"id-ID"}

	measure Pareto% =
			
			VAR CurrentSales=SUM('M&OD'[subtotal])
			VAR TotalSalesAll=CALCULATE(SUM('M&OD'[subtotal]),ALL('M&OD'[name]))
			VAR CumulatedSales=
			    CALCULATE(
			        SUM('M&OD'[subtotal]),
			        FILTER(
			            ALL('M&OD'[name]),
			            CALCULATE(SUM('M&OD'[subtotal]))>= CurrentSales
			        )
			    )
			RETURN
			DIVIDE(CumulatedSales, TotalSalesAll)
		lineageTag: a9b4a29c-9272-4de4-a249-7de0ef73bfe6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

